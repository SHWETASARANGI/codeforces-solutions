#include <iostream>
#include <vector>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    for (int i = 0; i < n; ++i) {
        int rank = 1;
        for (int j = 0; j < n; ++j) {
            if (a[j] > a[i]) {
                rank++;
            }
        }
        cout << rank << (i == n - 1 ? "" : " ");
    }
    cout << "\n";

    return 0;
}