#include <iostream>
#include <algorithm>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, k, l, c, d, p, nl, np;
    if (!(cin >> n >> k >> l >> c >> d >> p >> nl >> np)) return 0;

    // 1. Total toasts possible from drink
    int drink_toasts = (k * l) / nl;

    // 2. Total toasts possible from lime slices
    int lime_toasts = c * d;

    // 3. Total toasts possible from salt
    int salt_toasts = p / np;

    // The maximum total toasts the group can make is limited by the scarcest ingredient
    int total_toasts = min({drink_toasts, lime_toasts, salt_toasts});

    // Each friend gets an equal share of the total toasts
    cout << total_toasts / n << "\n";

    return 0;
}